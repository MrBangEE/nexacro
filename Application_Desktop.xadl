<?xml version="1.0" encoding="utf-8"?>
<ADL version="2.0">
  <Application id="Application_Desktop" screenid="Desktop_screen">
    <Layout>
      <MainFrame id="mainframe" showtitlebar="true" showstatusbar="true" left="0" top="0" width="1280" height="720" titletext="FullFrame">
        <VFrameSet id="VFrameSet" separatesize="200px,*">
          <Frames>
            <ChildFrame id="TopMenu" formurl=""/>
            <HFrameSet id="HFrameSet" separatesize="150,*">
              <Frames>
                <ChildFrame id="LeftMenu" formurl=""/>
                <ChildFrame id="WorkForm" formurl=""/>
              </Frames>
            </HFrameSet>
          </Frames>
        </VFrameSet>
      </MainFrame>
    </Layout>
  </Application>
</ADL>
