<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="Form_LeftMenu" width="200" height="720" titletext="New Form">
    <Layouts>
      <Layout height="720" width="200">
        <Div id="LeftMenu_Title" taborder="0" text="Notice Management" left="0" top="0" width="100%" height="100" font="normal 700 13pt/normal &quot;Arial&quot;">
          <Layouts>
            <Layout>
              <Div id="Div_LeftMenu" taborder="0" left="0" top="0" width="100%" height="100%"/>
            </Layout>
          </Layouts>
        </Div>
        <Grid id="Grid00" taborder="1" left="0" top="100" width="200" height="620" binddataset="LeftMenuDataset">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="80"/>
                <Column size="120"/>
              </Columns>
              <Rows>
                <Row size="24" band="head"/>
                <Row size="24"/>
              </Rows>
              <Band id="head">
                <Cell text="id"/>
                <Cell col="1" text="caption"/>
              </Band>
              <Band id="body">
                <Cell text="bind:id"/>
                <Cell col="1" text="bind:caption"/>
              </Band>
            </Format>
          </Formats>
        </Grid>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[]]></Script>
    <Objects>
      <Dataset id="LeftMenuDataset">
        <ColumnInfo>
          <Column id="id" type="STRING" size="256"/>
          <Column id="caption" type="STRING" size="256"/>
        </ColumnInfo>
        <Rows>
          <Row>
            <Col id="id">menu_1</Col>
            <Col id="caption">Notice Management</Col>
          </Row>
          <Row>
            <Col id="id">menu_2</Col>
            <Col id="caption">Receipt Management</Col>
          </Row>
        </Rows>
      </Dataset>
      <Dataset id="SubMenuDataset">
        <ColumnInfo>
          <Column id="id" type="STRING" size="256"/>
          <Column id="pid" type="STRING" size="256"/>
          <Column id="caption" type="STRING" size="256"/>
          <Column id="url" type="STRING" size="256"/>
        </ColumnInfo>
        <Rows>
          <Row>
            <Col id="id">menu_11</Col>
            <Col id="pid">menu_1</Col>
            <Col id="caption">Notice list</Col>
          </Row>
          <Row>
            <Col id="id">menu_12</Col>
            <Col id="pid">menu_1</Col>
            <Col id="caption">Notice Detail</Col>
          </Row>
        </Rows>
      </Dataset>
    </Objects>
  </Form>
</FDL>
